const express = require("express");
const sqlite3 = require("sqlite3").verbose();
const bodyParser = require("body-parser");

const app = express();
const PORT = 3000;

app.use(bodyParser.urlencoded({ extended: true }));
app.use(express.static("public"));

const db = new sqlite3.Database("database.db");

// ✅ PERUBAHAN 1: tambah kolom kelas
db.run(`
  CREATE TABLE IF NOT EXISTS items (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    nama TEXT,
    kelas TEXT
  )
`);

app.get("/", (req, res) => {
  db.all("SELECT * FROM items", [], (err, rows) => {
    let html = `
    <html>
    <head>
      <title>Data Siswa Kelas XI</title>
      <link rel="stylesheet" href="/style.css">
    </head>
    <body>
      <div class="container">
        <h1>Data Siswa Kelas XI</h1>

        <!-- ✅ PERUBAHAN 2: tambah input kelas di form -->
        <form method="POST" action="/tambah">
          <input type="text" name="nama" placeholder="Masukkan nama" required>
          <input type="text" name="kelas" placeholder="Masukkan kelas" required>
          <button type="submit">Tambah</button>
        </form>

        <ul>
    `;

    // ✅ PERUBAHAN 3: tampilkan kelas di list
    rows.forEach((item) => {
      html += `
        <li>
          <span class="nama">${item.nama} - ${item.kelas}</span>
          <div class="aksi">
            <a href="/edit/${item.id}" class="edit">Edit</a>
            <a href="/hapus/${item.id}" class="hapus" onclick="return confirm('Yakin hapus?')">Hapus</a>
          </div>
        </li>
      `;
    });

    html += `
        </ul>
      </div>
    </body>
    </html>
    `;

    res.send(html);
  });
});

// ✅ PERUBAHAN 3 (lanjutan): simpan kelas ke database
app.post("/tambah", (req, res) => {
  const { nama, kelas } = req.body;
  db.run("INSERT INTO items (nama, kelas) VALUES (?, ?)", [nama, kelas]);
  res.redirect("/");
});

app.get("/edit/:id", (req, res) => {
  const { id } = req.params;

  db.get("SELECT * FROM items WHERE id = ?", [id], (err, row) => {
    // ✅ PERUBAHAN 4: tambah input kelas di form edit
    const html = `
    <html>
    <head>
      <title>Edit Data</title>
      <link rel="stylesheet" href="/style.css">
    </head>
    <body>
      <div class="container">
        <h1>Edit Data Siswa</h1>

        <form method="POST" action="/update/${row.id}">
          <input type="text" name="nama" value="${row.nama}" required>
          <input type="text" name="kelas" value="${row.kelas}" required>
          <button type="submit">Update</button>
        </form>

        <a href="/">Kembali</a>
      </div>
    </body>
    </html>
    `;

    res.send(html);
  });
});

// ✅ PERUBAHAN 4 (lanjutan): update nama + kelas
app.post("/update/:id", (req, res) => {
  const { id } = req.params;
  const { nama, kelas } = req.body;

  db.run("UPDATE items SET nama = ?, kelas = ? WHERE id = ?", [nama, kelas, id]);
  res.redirect("/");
});
//menghapus
app.get("/hapus/:id", (req, res) => {
  const { id } = req.params;
  db.run("DELETE FROM items WHERE id = ?", [id]);
  res.redirect("/");
});
//jalankan server
app.listen(PORT, () => {
  console.log(`http://localhost:${PORT}`);
});
